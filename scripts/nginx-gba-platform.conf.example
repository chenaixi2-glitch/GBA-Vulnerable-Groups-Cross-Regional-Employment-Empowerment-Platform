# GBA 平台 — Nginx 反代示例（2GB 轻量服务器，非 Docker）
# 用法：
#   sudo cp scripts/nginx-gba-platform.conf.example /etc/nginx/conf.d/gba.conf
#   sudo cp scripts/nginx-gba-locations.inc.example /etc/nginx/conf.d/gba-locations.inc
#   sudo nginx -t && sudo systemctl reload nginx
#
# 路由原则：
#   /api/auth|jobs|...  → Node  :3000
#   /api/*               → Python :8000
#   /mcp/*               → Python :8000（MCP SSE，与 FastAPI 同进程）
#   /health              → Python :8000

# 域名 HTTP → HTTPS
server {
    listen 80;
    server_name gba-vulnerable-groups-cross-regional-employment-empowerment.com www.gba-vulnerable-groups-cross-regional-employment-empowerment.com;
    return 301 https://$host$request_uri;
}

# 公网 IP 备用（仅 HTTP；证书绑域名，IP 不强制跳 HTTPS，DNS 异常时仍可访问）
server {
    listen 80;
    server_name 120.77.249.179;
    include /etc/nginx/conf.d/gba-locations.inc;
}

# 域名 HTTPS
server {
    listen 443 ssl;
    server_name gba-vulnerable-groups-cross-regional-employment-empowerment.com www.gba-vulnerable-groups-cross-regional-employment-empowerment.com;

    ssl_certificate     /etc/nginx/ssl/gba.crt;
    ssl_certificate_key /etc/nginx/ssl/gba.key;

    include /etc/nginx/conf.d/gba-locations.inc;
}

# 可选：仅内网 / 本机访问 MCP（不对外暴露工具接口）
# 在 gba-locations.inc 中将 location /mcp/ 替换为：
#
# location /mcp/ {
#     allow 127.0.0.1;
#     deny all;
#     proxy_pass http://127.0.0.1:8000/mcp/;
#     ...
# }
