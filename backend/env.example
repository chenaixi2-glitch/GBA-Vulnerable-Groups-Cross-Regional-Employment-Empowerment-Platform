# ============================================================
# AI Career Copilot 后端环境变量模板
# 复制为 backend/.env 后按环境修改（.env 已在 .gitignore 中，不会提交）
# ============================================================

# ---- AI API Keys（必填，向团队索取或自行申请）----
# LLM 通过 SiliconFlow 调用，密钥勿写入代码或前端
SILICONFLOW_API_KEY=your_siliconflow_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key
LANGCHAIN_API_KEY=your_langchain_api_key

# ---- 本地开发（XAMPP MariaDB + 本机 Redis）----
# SERVER_HOST=127.0.0.1
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=ai_career_copilot
# MYSQL_CHARSET=utf8mb4
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0

# ---- 线上生产（阿里云轻量服务器 + RDS MySQL）----
# 轻量服务器公网 IP（Redis 跑在同一台机器上时用 127.0.0.1 即可）
# SERVER_HOST=120.77.249.179
# MySQL 使用 RDS（与 Node 认证后端共用同一 RDS 实例，但库名不同）
# MYSQL_HOST=rm-wz93273d48x7x6d5k5o.mysql.rds.aliyuncs.com
# MYSQL_PORT=3306
# MYSQL_USER=GBA_platform
# MYSQL_PASSWORD=your_rds_password
# MYSQL_DATABASE=ai_career_copilot
# MYSQL_CHARSET=utf8mb4
# Redis 安装在轻量服务器本机
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0

# ---- JWT（与 Node server 共用，用于识别已登录用户）----
# JWT_SECRET=change_me
# JWT_EXPIRES_IN=7d

# ---- FastAPI 服务 ----
# FASTAPI_HOST=0.0.0.0
# FASTAPI_PORT=8000
# FASTAPI_DEBUG=false
# FASTAPI_WORKERS=2
