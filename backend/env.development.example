# Python AI 后端 — 本地开发（XAMPP MariaDB 10.x + 本机 Redis）
# 复制为 backend/.env 后使用（.env 已在 .gitignore 中）

# ---- AI API Keys（必填）----
SILICONFLOW_API_KEY=your_siliconflow_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key
LANGCHAIN_API_KEY=your_langchain_api_key

# ---- 本地 XAMPP MariaDB ----
SERVER_HOST=127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_career_copilot
MYSQL_CHARSET=utf8mb4

# ---- 本机 Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- JWT（与 Node server 共用）----
JWT_SECRET=change_me_dev_only
JWT_EXPIRES_IN=7d

# ---- FastAPI ----
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=true
FASTAPI_WORKERS=2
