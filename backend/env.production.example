# Python AI 后端 — 线上生产（阿里云轻量服务器 + RDS MySQL 8.0）
# 复制为 backend/.env 后使用（.env 已在 .gitignore 中，切勿提交 Git）

# ---- AI API Keys（必填）----
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
LANGCHAIN_API_KEY=

# ---- 轻量服务器（公网 IP，供 RDS 白名单等；Redis 跑在同一台机器上）----
# 站点访问域名：https://gba-vulnerable-groups-cross-regional-employment-empowerment.com
# 公网 IP 备用：http://120.77.249.179
SERVER_HOST=120.77.249.179

# ---- 阿里云 RDS MySQL 8.0（AI 业务库，与 Node 的 gba_website 同实例不同库）----
MYSQL_HOST=rm-wz93273d48x7x6d5k5o.mysql.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=GBA_platform
MYSQL_PASSWORD=your_rds_password
MYSQL_DATABASE=ai_career_copilot
MYSQL_CHARSET=utf8mb4

# ---- Redis（安装在轻量服务器本机）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- JWT（须与 server/.env.production 的 JWT_SECRET 一致）----
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# ---- FastAPI ----
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=false
# 2GB 轻量服务器：单 worker，避免与 Node/Redis/Nginx 争抢内存
FASTAPI_WORKERS=1
