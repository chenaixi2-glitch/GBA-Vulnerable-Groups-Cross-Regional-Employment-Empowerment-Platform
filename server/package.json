{
  "name": "gba-platform-server",
  "version": "1.0.0",
  "description": "GBA Vulnerable Groups Cross-Regional Employment Empowerment Platform - Node.js + Express backend (JWT auth, MariaDB/MySQL compatible)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "db:init": "node src/scripts/initDb.js && node src/scripts/runMigrations.js",
    "db:migrate": "node src/scripts/runMigrations.js"
  },
  "keywords": [
    "express",
    "jwt",
    "mysql",
    "mariadb",
    "gba"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
