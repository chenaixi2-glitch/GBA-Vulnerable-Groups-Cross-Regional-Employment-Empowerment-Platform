# Node 认证 API — 本地开发（XAMPP MariaDB 10.x）
# 复制为 server/.env.development 后使用（该文件已在 .gitignore 中）
# 默认 NODE_ENV=development，npm run dev / npm run db:init 会自动加载

PORT=3000

# XAMPP 本地 MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gba_website
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=10
DB_SSL=false

# 与 Python 后端共用，本地可先用默认值
JWT_SECRET=change_me_dev_only
JWT_EXPIRES_IN=7d

CORS_ORIGIN=*
