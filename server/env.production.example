# Node 认证 API — 线上生产（阿里云轻量服务器 + RDS MySQL 8.0）
# 复制为 server/.env.production 后使用（该文件已在 .gitignore 中）
# 部署：NODE_ENV=production 或 pm2 start ecosystem.config.js --env production

PORT=3000

# 阿里云 RDS MySQL 8.0（Node 用户库 gba_website）
DB_HOST=rm-wz93273d48x7x6d5k5o.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=GBA_platform
DB_PASSWORD=your_rds_password
DB_NAME=gba_website
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=10
DB_SSL=false

# 生产务必换成强随机串：openssl rand -hex 32
# 须与 backend/.env 中的 JWT_SECRET 保持一致
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# 前端访问地址（域名 + 公网 IP 备用，逗号分隔）
CORS_ORIGIN=https://gba-vulnerable-groups-cross-regional-employment-empowerment.com,http://gba-vulnerable-groups-cross-regional-employment-empowerment.com,http://120.77.249.179
